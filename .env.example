VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# When true, Points require every moto 1…max scored. Default false = Points after any one moto.
VITE_REQUIRE_ALL_MOTOS=false
# Server-only (never VITE_): used by Vite /api/analyze proxy for Analyze AI (Groq).
GROQ_API_KEY=
# Optional Groq model id (default openai/gpt-oss-120b). llama-3.3-70b-versatile is retired on free/dev tiers.
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: override Analyze AI endpoint (defaults to /api/analyze in dev).
# VITE_ANALYZE_API_URL=
