VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Postgres URI for scripts/seed-moto-challenge.ps1 (NOT the service_role API key).
# Supabase → Project Settings → Database → Connection string (URI).
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
# SUPABASE_DIRECT_CONNECT_STRING=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or password only (script builds db.<ref>.supabase.co from VITE_SUPABASE_URL):
# SUPABASE_DB_PASSWORD=
# When true, Points require every moto 1…max scored. Default false = Points after any one moto.
VITE_REQUIRE_ALL_MOTOS=false
# Cap Dashboard to N earliest series events (e.g. 2 for ≤2-event layout). Unset = all.
# VITE_DASHBOARD_MAX_EVENTS=2
# Server-only (never VITE_): used by Vite /api/analyze proxy for Analyze AI (xAI Grok).
XAI_API_KEY=
# Optional xAI model id (default grok-4.7).
# XAI_MODEL=grok-4.7
# Optional: override Analyze AI endpoint (defaults to /api/analyze in dev).
# VITE_ANALYZE_API_URL=
